---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Chaos from '../components/story/Chaos.astro';
import Ordnung from '../components/story/Ordnung.astro';
import UseCases from '../components/story/UseCases.astro';
import SecondBrain from '../components/story/SecondBrain.astro';
import Closing from '../components/story/Closing.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
