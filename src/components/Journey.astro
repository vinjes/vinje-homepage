---
import { TIMELINE } from '../scroll/timeline';
// Unterknoten der Detail-Zooms (illustrativ, ohne Namen und Zahlen)
const EMAIL_PARTS = ['Absender', 'Betreff', 'Kategorie', 'verknüpfter Kunde', 'Projekt'];
const PROJECT_PARTS = ['Kunde', 'Angebot', 'Termin', 'Aufgabe', 'Dokument', 'Rechnung'];
// Signalpfad der backcall-Station: Planet → Call → Knowledge → Task → Employee
const CALL_NODES = ['backcall', 'Call', 'Knowledge', 'Task', 'Employee'];
---
<!-- ==================== SCROLL-ERLEBNIS: Stern → E-Mails → Graph → Workflow → backcall → Welt → Leistungen … Kontakt ==================== -->
<!-- Die Stage (Canvas + Overlays) ist sticky über die ganze Section: oben die gepinnte Strecke (data-track), danach der untere Teil (Slot "lower") im normalen Fluss darüber. -->
<!-- Zeitachse, Stationen und Scroll-Längen: src/scroll/timeline.ts -->
<section id="journey" class="journey relative" aria-label="Wie VINJE Informationen verknüpft und Prozesse automatisiert">
    <div data-stage class="sticky top-0 h-screen w-full overflow-hidden">
        <!-- Station hero: erstes Bild, liegt über Canvas und Schleier (im statischen Modus zuerst im Fluss) -->
        <div data-scene="hero" class="journey-scene journey-hero">
            <slot />
        </div>

        <!-- Silberwellen aus dem bisherigen Hero, blenden beim Scrollen aus -->
        <div data-waves class="journey-waves pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
            <!-- Sanft pulsierende silbrig-weiße Lichtakzente -->
            <div class="animate-silver-orb absolute -top-24 right-1/4 w-[28rem] h-[28rem] rounded-full bg-gradient-to-br from-white/90 via-[#DFDDD5]/50 to-transparent blur-3xl"></div>
            <div class="animate-silver-orb absolute -bottom-28 left-10 w-[32rem] h-[32rem] rounded-full bg-gradient-to-tr from-[#C9C7BE]/45 via-white/85 to-transparent blur-3xl" style="animation-delay: -6s;"></div>

            <!-- Echtzeit-Canvas für fließende metallische Seidenwellen -->
            <canvas id="hero-wave-canvas" class="absolute inset-0 w-full h-full opacity-90"></canvas>

            <!-- Vektor-Wellen & animierte Licht-Glanzlinien -->
            <svg class="relative w-full h-full object-cover opacity-85" viewBox="0 0 1440 820" fill="none" preserveAspectRatio="xMidYMid slice">
                <defs>
                    <linearGradient id="silverWave1" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.95"/>
                        <stop offset="38%" stop-color="#DFDDD5" stop-opacity="0.65"/>
                        <stop offset="68%" stop-color="#AEACA3" stop-opacity="0.32"/>
                        <stop offset="100%" stop-color="#F7F6F2" stop-opacity="0"/>
                    </linearGradient>
                    <linearGradient id="silverWave2" x1="100%" y1="0%" x2="0%" y2="100%">
                        <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.9"/>
                        <stop offset="45%" stop-color="#C9C7BE" stop-opacity="0.45"/>
                        <stop offset="80%" stop-color="#8F8D85" stop-opacity="0.22"/>
                        <stop offset="100%" stop-color="#F7F6F2" stop-opacity="0"/>
                    </linearGradient>
                    <linearGradient id="silverHighlight" x1="0%" y1="50%" x2="100%" y2="50%">
                        <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0"/>
                        <stop offset="50%" stop-color="#FFFFFF" stop-opacity="0.95"/>
                        <stop offset="100%" stop-color="#B5B3AA" stop-opacity="0.2"/>
                    </linearGradient>
                </defs>

                <!-- Obere rechte metallische Seidenwelle -->
                <g class="animate-wave-slow">
                    <path d="M680 -60 C820 140, 1080 230, 1500 280 L1500 -60 Z" fill="url(#silverWave2)"/>
                    <path d="M760 -40 C910 155, 1140 215, 1480 250" stroke="url(#silverHighlight)" stroke-width="2.5"/>
                    <path class="animate-wave-shimmer" d="M760 -40 C910 155, 1140 215, 1480 250" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round"/>
                    <path d="M840 -50 C960 120, 1190 190, 1490 210" stroke="#9C9A92" stroke-opacity="0.28" stroke-width="1.2"/>
                </g>

                <!-- Untere linke fließende Silberwelle -->
                <g class="animate-wave-reverse">
                    <path d="M-80 240 C240 310, 390 560, 740 610 C1050 655, 1260 540, 1520 670 L1520 880 L-80 880 Z" fill="url(#silverWave1)"/>
                    <path d="M-60 280 C250 350, 380 575, 730 615 C1030 650, 1250 560, 1500 660" stroke="url(#silverHighlight)" stroke-width="3"/>
                    <path class="animate-wave-shimmer-delayed" d="M-60 280 C250 350, 380 575, 730 615 C1030 650, 1250 560, 1500 660" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round"/>
                    <path d="M-40 390 C210 445, 360 640, 680 655 C940 668, 1150 610, 1480 740" stroke="#8C8A82" stroke-opacity="0.22" stroke-width="1.5"/>
                </g>
            </svg>
        </div>

        <canvas data-canvas class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>

        <!-- Beschriftungen für Graph-Cluster (illustrative Beispiele, keine Kundendaten) -->
        <span data-label="0" class="journey-label" aria-hidden="true">Customer</span>
        <span data-label="1" class="journey-label" aria-hidden="true">Email</span>
        <span data-label="2" class="journey-label" aria-hidden="true">Project</span>
        <span data-label="3" class="journey-label" aria-hidden="true">Invoice</span>
        <span data-label="4" class="journey-label" aria-hidden="true">Knowledge</span>

        <!-- Fächer, in die die E-Mails sortiert werden (illustrativ) -->
        <span data-bin="0" class="journey-label journey-bin" aria-hidden="true">Anfrage</span>
        <span data-bin="1" class="journey-label journey-bin" aria-hidden="true">Angebot</span>
        <span data-bin="2" class="journey-label journey-bin" aria-hidden="true">Rechnung</span>
        <span data-bin="3" class="journey-label journey-bin" aria-hidden="true">Support</span>

        <!-- Detail-Zooms: Unterknoten kreisen um einen Email- bzw. Project-Knoten -->
        <span data-detail="email" data-i="title" class="journey-label journey-label-title" aria-hidden="true">Email</span>
        {EMAIL_PARTS.map((t) => <span data-detail="email" class="journey-label" aria-hidden="true">{t}</span>)}
        <span data-detail="project" data-i="title" class="journey-label journey-label-title" aria-hidden="true">Project</span>
        {PROJECT_PARTS.map((t) => <span data-detail="project" class="journey-label" aria-hidden="true">{t}</span>)}

        <!-- backcall: Planet und Knoten des Signalpfads -->
        {CALL_NODES.map((t, k) => <span data-call={k} class:list={['journey-label', k === 0 && 'journey-label-title']} aria-hidden="true">{t}</span>)}

        <!-- Unterer Teil: Ablauf-Schritte als Knoten, Vincent & Jesse als verbundene Knoten (Desktop) -->
        {['01', '02', '03', '04'].map((t, k) => <span data-step-node={k} class="journey-label journey-bin" aria-hidden="true">{t}</span>)}
        <span data-person="0" class="journey-person" aria-hidden="true"><img src="./images/vincent.jpg" alt="" width="112" height="112" loading="lazy" /></span>
        <span data-person="1" class="journey-person" aria-hidden="true"><img src="./images/jesse.jpg" alt="" width="112" height="112" loading="lazy" /></span>

        <div data-veil class="journey-veil absolute inset-0 pointer-events-none" aria-hidden="true"></div>
        <!-- Ruhiger Papier-Schleier hinter dem unteren Teil (Formulare, lange Texte) -->
        <div data-veil-lower class="journey-veil-lower absolute inset-0 pointer-events-none" aria-hidden="true"></div>

        <div data-overlay class="absolute inset-0 pointer-events-none">
            <!-- Szenen hängen an Stationen der Zeitachse (data-scene = Station); data-line schaltet nacheinander frei -->
            <!-- Szene 1: Informationsflut -->
            <div data-scene="flood" class="journey-scene">
                <p class="journey-kicker">01 // Informationsflut</p>
                <h2 class="journey-title">Informationen, überall.</h2>
                <p class="journey-text" data-line>Kunden-E-Mails, Anrufe und Support-Anfragen – ungeordnet, verteilt und ständig neu.</p>
            </div>

            <!-- Szene 2: VINJE ordnet -->
            <div data-scene="sort" class="journey-scene">
                <p class="journey-kicker">02 // vinje Engine</p>
                <h2 class="journey-title">VINJE ordnet die Ströme.</h2>
                <p class="journey-text"><span data-line>E-Mails werden analysiert, Telefonate transkribiert, Anfragen kategorisiert.</span> <span data-line>Mistral & lokale LLMs auf europäischen Servern erkennen, was zusammengehört.</span></p>
                <p class="journey-engine" data-line>backmail, backcall &amp; Multi-Agenten</p>
            </div>

            <!-- Szene 3: Knowledge Graph -->
            <div data-scene="graph" class="journey-scene">
                <p class="journey-kicker">03 // Knowledge Graph</p>
                <h2 class="journey-title">Ein Netzwerk statt Chaos.</h2>
                <p class="journey-text"><span data-line>Kunden, Anfragen, Dokumente und Termine werden verknüpft –</span> <span data-line>zu Wissen, das im Unternehmen bleibt.</span></p>
            </div>

            <!-- Szene 4: Automatisierter Workflow (Schritte schalten mit dem Pfad frei) -->
            <div data-scene="workflow" class="journey-scene">
                <p class="journey-kicker">04 // Automatisierte Prozesse</p>
                <h2 class="journey-title">Eine Anfrage, sechs Schritte.</h2>
                <ol class="journey-steps">
                    <li data-step>Anfrage kommt per E-Mail rein</li>
                    <li data-step>KI erkennt den Inhalt und identifiziert den Kunden</li>
                    <li data-step>Relevante Unternehmensinformationen werden abgerufen</li>
                    <li data-step>Anfrage wird kategorisiert</li>
                    <li data-step>Passende Antwort wird vorbereitet</li>
                    <li data-step>Termin oder Aufgabe wird angelegt</li>
                </ol>
            </div>

            <!-- Szene 5: backcall – derselbe Graph, zweiter Kanal (Schritte schalten mit dem Signalpfad frei) -->
            <div data-scene="call" class="journey-scene">
                <p class="journey-kicker">05 // backcall</p>
                <h2 class="journey-title">Ein Anruf, fünf Schritte.</h2>
                <ol class="journey-steps">
                    <li data-step>Anruf kommt rein, backcall nimmt ab</li>
                    <li data-step>Das Anliegen wird erkannt, einfache Fragen direkt beantwortet</li>
                    <li data-step>Nach dem Ausweisen: Auskunft aus euren Daten</li>
                    <li data-step>Vorläufiger Eintrag, Formular oder Nachricht wird angelegt</li>
                    <li data-step>Euer Team prüft und bestätigt jeden Fall</li>
                </ol>
            </div>

            <!-- Szene 6: Strukturiertes Unternehmen, die Welt im Ganzen -->
            <div data-scene="result" class="journey-scene">
                <p class="journey-kicker">06 // Ergebnis</p>
                <h2 class="journey-title">Aus Chaos wird Struktur.</h2>
                <p class="journey-text" data-line>Zentralisiertes Wissen, strukturierte Informationen, automatisierte Prozesse – weniger manuelle Arbeit und ein besserer Überblick.</p>
                <div class="journey-products" data-line>
                    <p class="journey-kicker">Produktives System · Kundensystem</p>
                    <ul>
                        <li><strong>backmail</strong> – KI-E-Mail-Client &amp; Auto-Antworten</li>
                        <li><strong>backcall</strong> – KI-Voice-Assistant für Telefonanrufe</li>
                    </ul>
                </div>
            </div>
        </div>

        <div data-progress class="journey-progress" aria-hidden="true">
            <div data-progress-fill class="journey-progress-fill"></div>
        </div>
    </div>

    <!-- Scroll-Strecke: ein Block je Segment der Zeitachse (Länge Desktop/Mobil aus timeline.ts) -->
    <div data-track class="journey-track" aria-hidden="true">
        {TIMELINE.filter((s) => !s.flow).map((s) => (
            <div data-seg={s.id} class="journey-seg" style={`--seg-d: ${s.vh[0]}vh; --seg-m: ${s.vh[1]}vh;`}></div>
        ))}
        <!-- Lücke bis zum unteren Teil: dessen Fortschritt zählt ab der Bildschirmmitte (journey.ts, computeP) -->
        <div class="journey-tail"></div>
    </div>
    <!-- Unterer Teil: Leistungen, Ablauf, Über uns, Kontakt; Blöcke tragen data-seg und laufen über der Bühne -->
    <div class="journey-lower">
        <slot name="lower" />
    </div>
</section>

<style>
    .journey-label {
        position: absolute;
        left: 0;
        top: 0;
        opacity: 0;
        pointer-events: none;
        font-size: 11px;
        letter-spacing: 0.01em;
        color: #555555;
        white-space: nowrap;
        will-change: transform, opacity;
    }
    .journey-label::before {
        content: "";
        display: inline-block;
        width: 5px;
        height: 5px;
        margin-right: 6px;
        border-radius: 9999px;
        background: #141414;
        vertical-align: middle;
    }

    .journey-bin {
        translate: -50% 0;
        font-size: 12px;
        color: #141414;
    }
    .journey-label-title {
        font-size: 13px;
        font-weight: 600;
        color: #141414;
    }
    .journey-label-title::before {
        width: 7px;
        height: 7px;
    }

    /* Vincent & Jesse: Fotos tauchen an den beiden Knoten auf (nur Desktop, dekorativ) */
    .journey-person {
        position: absolute;
        left: 0;
        top: 0;
        width: 4.5rem;
        height: 4.5rem;
        margin: -2.25rem 0 0 -2.25rem;
        border-radius: 9999px;
        overflow: hidden;
        border: 1px solid #E2E0D8;
        box-shadow: 0 0 0 4px #F7F6F2;
        opacity: 0;
        pointer-events: none;
        will-change: transform, opacity;
    }
    .journey-person img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    @media (max-width: 767px) {
        .journey-person {
            display: none;
        }
    }

    /* Die Stage belegt oben 100vh im Fluss; die Strecke beginnt trotzdem beim ersten Pixel */
    .journey-track {
        margin-top: -100vh;
    }
    .journey-lower {
        position: relative;
        z-index: 10;
    }
    .journey-seg {
        height: var(--seg-m);
    }
    @media (min-width: 768px) {
        .journey-seg {
            height: var(--seg-d);
        }
    }
    .journey-tail {
        height: 50vh;
    }

    /* Heller Schleier hinter dem Text, damit Lesbarkeit über dem Graphen bleibt */
    .journey-veil {
        background: linear-gradient(to right, rgba(247, 246, 242, 0.92) 0%, rgba(247, 246, 242, 0.6) 35%, rgba(247, 246, 242, 0) 65%);
    }
    @media (max-width: 767px) {
        .journey-veil {
            background: linear-gradient(to top, rgba(247, 246, 242, 0.95) 0%, rgba(247, 246, 242, 0.7) 35%, rgba(247, 246, 242, 0) 60%);
        }
    }
    .journey-veil-lower {
        opacity: 0;
        background: linear-gradient(to right, rgba(247, 246, 242, 0.9) 0%, rgba(247, 246, 242, 0.7) 45%, rgba(247, 246, 242, 0) 75%);
    }
    @media (max-width: 767px) {
        .journey-veil-lower {
            background: rgba(247, 246, 242, 0.82);
        }
    }

    .journey-scene {
        position: absolute;
        left: 1.25rem;
        right: 1.25rem;
        bottom: 5.5rem;
        opacity: 0;
        will-change: transform, opacity;
    }
    @media (min-width: 768px) {
        .journey-scene {
            left: 4rem;
            right: auto;
            bottom: auto;
            top: 50%;
            width: min(34rem, 40vw);
            translate: 0 -50%;
        }
    }
    /* Hero: über Canvas und Schleier, etwas breiter; mobil passt er in eine Bildschirmhöhe */
    .journey-hero {
        z-index: 2;
        opacity: 1;
    }
    /* mobil: im ersten Bild liegt die Stage noch unter dem Header (5rem); Button bleibt frei vom Chat-Button */
    @media (max-width: 767px) {
        .journey-hero {
            bottom: calc(5.5rem + 5rem);
        }
    }
    @media (min-width: 768px) {
        .journey-hero {
            width: min(38rem, 46vw);
        }
    }

    .journey-kicker {
        font-size: 0.75rem;
        color: #555555;
        margin-bottom: 0.75rem;
    }
    .journey-title {
        font-family: "Plus Jakarta Sans", "Inter", sans-serif;
        font-weight: 600;
        font-size: clamp(1.75rem, 3.6vw, 3rem);
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: #141414;
    }
    .journey-text {
        margin-top: 1rem;
        font-size: 1rem;
        line-height: 1.6;
        color: #555555;
        max-width: 30rem;
    }

    .journey-engine {
        margin-top: 1rem;
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 500;
        color: #141414;
        padding: 0.35rem 0.75rem;
        border: 1px solid #E2E0D8;
        border-radius: 9999px;
        background: rgba(247, 246, 242, 0.85);
    }
    .journey-products {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #E2E0D8;
        max-width: 30rem;
    }
    .journey-products .journey-kicker {
        margin-bottom: 0.5rem;
    }
    .journey-products ul {
        display: grid;
        gap: 0.35rem;
        font-size: 0.95rem;
        color: #555555;
    }
    .journey-products strong {
        color: #141414;
        font-weight: 600;
    }

    .journey-steps {
        margin-top: 1.25rem;
        display: grid;
        gap: 0.5rem;
        list-style: none;
        counter-reset: step;
        padding: 0;
    }
    .journey-steps li {
        counter-increment: step;
        font-size: 0.95rem;
        color: #8f8d85;
        transition: color 0.2s ease;
    }
    .journey-steps li::before {
        content: "0" counter(step) "  ";
        color: #555555;
        font-variant-numeric: tabular-nums;
    }
    .journey-steps li.is-on {
        color: #141414;
    }

    .journey-progress {
        position: absolute;
        left: 1.25rem;
        right: 1.25rem;
        bottom: 2rem;
        height: 1px;
        background: #E2E0D8;
    }
    .journey-progress-fill {
        height: 1px;
        background: #141414;
        transform-origin: left;
        transform: scaleX(0);
    }

    /* Ohne Bewegung oder ohne WebGL: Canvas als Standbild, Texte darunter untereinander */
    .journey.journey-static {
        height: auto;
        display: flex;
        flex-direction: column;
    }
    .journey.journey-static [data-track],
    .journey.journey-static [data-waves],
    .journey.journey-static .journey-bin,
    .journey.journey-static .journey-person,
    .journey.journey-static .journey-veil-lower {
        display: none;
    }
    .journey.journey-static .journey-hero {
        padding: 2.5rem 1.25rem 1rem;
    }
    .journey.journey-static :global([data-hero-by]),
    .journey.journey-static :global([data-hero-h1]),
    .journey.journey-static :global([data-hero-sub]) {
        transform: none !important;
    }
    .journey.journey-static [data-stage] {
        position: relative;
        height: auto;
        overflow: visible;
    }
    .journey.journey-static [data-canvas] {
        position: relative;
        inset: auto;
        height: 70vh;
        min-height: 420px;
    }
    .journey.journey-static [data-overlay] {
        position: relative;
        inset: auto;
        padding: 2.5rem 1.25rem 3rem;
    }
    .journey.journey-static .journey-scene {
        position: relative;
        left: auto;
        right: auto;
        top: auto;
        bottom: auto;
        width: auto;
        translate: none;
        transform: none !important;
        opacity: 1 !important;
        margin-bottom: 2.5rem;
    }
    .journey.journey-static .journey-label {
        opacity: 0.8;
    }
    .journey.journey-static .journey-veil {
        display: none;
    }
    .journey.journey-static [data-progress] {
        display: none;
    }
    .journey.journey-static .journey-steps li {
        color: #141414;
    }
    .journey.journey-static [data-line] {
        opacity: 1 !important;
    }
</style>

<script>
    import { mountJourney } from '../scroll/journey';
    mountJourney(document.getElementById('journey'));
</script>
