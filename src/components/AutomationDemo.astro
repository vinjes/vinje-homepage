---
// Mini-Demo zu Stufe 01: ein Workflow im Stil von n8n, der beim Sichtbarwerden einmal durchläuft (Beispiel, keine echten Daten)
const NODES = [
    { id: 'n0', x: 4, y: 16, t: 'E-Mail', s: 'neue Anfrage', c: '#141414' },
    { id: 'n1', x: 110, y: 16, t: 'KI-Analyse', s: 'Thema erkannt', c: '#2563EB' },
    { id: 'n2', x: 216, y: 16, t: 'CRM', s: 'Kunde gefunden', c: '#555555' },
    { id: 'n3', x: 110, y: 120, t: 'Antwort', s: 'Entwurf fertig', c: '#047857' },
    { id: 'n4', x: 216, y: 120, t: 'Kalender', s: 'Termin angelegt', c: '#047857' },
];
const EDGES = [
    { id: 'e1', d: 'M100 38 H110' },
    { id: 'e2', d: 'M206 38 H216' },
    { id: 'e3', d: 'M264 60 C264 92 158 88 158 120' },
    { id: 'e4', d: 'M264 60 V120' },
];
// Reihenfolge des Laufs; die Verzweigung läuft parallel
const STEPS = [['n0'], ['e1', 'n1'], ['e2', 'n2'], ['e3', 'e4', 'n3', 'n4']];
---
<figure data-flow data-steps={JSON.stringify(STEPS)} class="reveal rounded-2xl bg-white border border-silverBorder shadow-[0_24px_60px_-24px_rgba(20,20,20,0.25)] p-4 sm:p-6 text-ink">
    <div class="flex items-center justify-between gap-3">
        <div>
            <p class="font-display text-sm font-semibold">Ablauf · Eingehende Anfragen</p>
            <p class="text-[11px] text-inkMuted flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>Aktiv · Demo</p>
        </div>
        <button type="button" data-run class="shrink-0 whitespace-nowrap px-3 py-1.5 rounded-lg bg-ink text-paper text-xs font-medium hover:opacity-90 transition-opacity">▶ Ausführen</button>
    </div>

    <div class="flow-canvas mt-4 rounded-xl border border-silverBorder p-1 sm:p-2">
        <svg viewBox="0 0 316 172" class="w-full h-auto" role="img" aria-label="Workflow: E-Mail, KI-Analyse, CRM, dann Antwort-Entwurf und Kalendertermin">
            {EDGES.map((e) => <path data-id={e.id} d={e.d} class="flow-edge" fill="none" />)}
            <text x="122" y="106" font-size="9" fill="#555555">Anfrage</text>
            <text x="268" y="96" font-size="9" fill="#555555">Termin</text>
            {NODES.map((n) => (
                <g data-id={n.id} class="flow-node" transform={`translate(${n.x} ${n.y})`}>
                    <rect width="96" height="44" rx="8" class="flow-box" />
                    <rect x="8" y="13" width="18" height="18" rx="5" fill={n.c} />
                    <text x="32" y="20" font-size="10" font-weight="600" fill="#141414">{n.t}</text>
                    <text x="32" y="32" font-size="8" fill="#555555">{n.s}</text>
                    <g class="flow-ok" transform="translate(88 0)">
                        <circle r="7" fill="#047857" />
                        <path d="M-3 0 L-1 2.5 L3 -2.5" stroke="#fff" stroke-width="1.6" fill="none" />
                    </g>
                </g>
            ))}
        </svg>
    </div>

    <div class="mt-3 grid grid-cols-3 gap-2 text-center">
        <div class="rounded-xl bg-paper border border-silverBorder p-2.5"><p class="text-[11px] text-inkMuted">Heute erledigt</p><p class="text-sm font-semibold">46</p></div>
        <div class="rounded-xl bg-paper border border-silverBorder p-2.5"><p class="text-[11px] text-inkMuted">Ø Dauer</p><p class="text-sm font-semibold">1,8 s</p></div>
        <div class="rounded-xl bg-paper border border-silverBorder p-2.5"><p class="text-[11px] text-inkMuted">Manuell nötig</p><p class="text-sm font-semibold">0</p></div>
    </div>
</figure>

<style>
    .flow-canvas {
        background-color: #FBFAF7;
        background-image: radial-gradient(#E2E0D8 1px, transparent 1px);
        background-size: 12px 12px;
    }
    .flow-edge {
        stroke: #C8C6BE;
        stroke-width: 1.5;
        transition: stroke 0.3s;
    }
    .flow-edge:global(.is-run) {
        stroke: #141414;
        stroke-dasharray: 4 3;
        animation: flow-move 0.6s linear infinite;
    }
    .flow-box {
        fill: #fff;
        stroke: #E2E0D8;
        transition: stroke 0.3s;
    }
    .flow-node:global(.is-run) .flow-box {
        stroke: #141414;
        stroke-width: 1.5;
    }
    .flow-ok {
        opacity: 0;
        transition: opacity 0.3s;
    }
    .flow-node:global(.is-run) .flow-ok {
        opacity: 1;
    }
    @keyframes flow-move {
        to { stroke-dashoffset: -7; }
    }
    @media (prefers-reduced-motion: reduce) {
        .flow-edge:global(.is-run) {
            animation: none;
        }
    }
</style>

<script>
    // Lauf: Schritte nacheinander markieren; startet beim ersten Sichtbarwerden und per Button erneut
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (const flow of document.querySelectorAll<HTMLElement>('[data-flow]')) {
        const steps: string[][] = JSON.parse(flow.dataset.steps ?? '[]');
        const els = (id: string) => flow.querySelectorAll(`[data-id="${id}"]`);
        let timers: number[] = [];
        const run = () => {
            timers.forEach(clearTimeout);
            flow.querySelectorAll('.is-run').forEach((el) => el.classList.remove('is-run'));
            timers = steps.map((ids, i) =>
                window.setTimeout(() => ids.forEach((id) => els(id).forEach((el) => el.classList.add('is-run'))), reduced ? 0 : 300 + i * 650),
            );
        };
        flow.querySelector('[data-run]')?.addEventListener('click', run);
        const io = new IntersectionObserver(([e]) => {
            if (!e.isIntersecting) return;
            io.disconnect();
            run();
        }, { threshold: 0.4 });
        io.observe(flow);
    }
</script>
