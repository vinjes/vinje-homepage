<script>
    interface Message {
        role: 'user' | 'assistant';
        content: string;
    }

    const chatPanel = document.getElementById('vinje-chat-panel');
    const chatToggle = document.getElementById('vinje-chat-toggle');
    const chatClose = document.getElementById('vinje-chat-close');
    const chatMessages = document.getElementById('vinje-chat-messages');
    const chatStarters = document.getElementById('vinje-chat-starters');
    const chatForm = document.getElementById('vinje-chat-form') as HTMLFormElement | null;
    const chatInput = document.getElementById('vinje-chat-input') as HTMLInputElement | null;
    const chatSend = document.getElementById('vinje-chat-send') as HTMLButtonElement | null;
    const chatHandoff = document.getElementById('vinje-chat-handoff');
    const transferBtn = document.getElementById('vinje-transfer-btn');
    const starterBtns = document.querySelectorAll('.chat-starter-btn');

    const history: Message[] = [];
    let latestTopic = 'KI-Automatisierung';

    const formatMarkdown = (text: string): string => {
        const escaped = text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
        return escaped
            .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
            .replace(/\n/g, '<br>');
    };

    const toggleChat = (forceOpen?: boolean) => {
        if (!chatPanel) return;
        const isHidden = chatPanel.classList.contains('hidden');
        const shouldOpen = forceOpen !== undefined ? forceOpen : isHidden;

        if (shouldOpen) {
            chatPanel.classList.remove('hidden');
            chatPanel.classList.add('flex');
            setTimeout(() => chatInput?.focus(), 80);
        } else {
            chatPanel.classList.add('hidden');
            chatPanel.classList.remove('flex');
        }
    };

    chatToggle?.addEventListener('click', () => toggleChat());
    chatClose?.addEventListener('click', () => toggleChat(false));

    const appendBubble = (role: 'user' | 'assistant', content: string) => {
        if (!chatMessages) return;

        const wrapper = document.createElement('div');
        if (role === 'user') {
            wrapper.className = 'flex justify-end';
            wrapper.innerHTML = `
                <div class="max-w-[82%] p-3 rounded-2xl rounded-tr-sm bg-ink text-paper text-xs leading-relaxed">
                    ${formatMarkdown(content)}
                </div>
            `;
        } else {
            wrapper.className = 'flex items-start gap-2.5';
            wrapper.innerHTML = `
                <div class="w-6 h-6 rounded-full bg-ink text-paper flex items-center justify-center shrink-0 mt-0.5 text-[10px] font-mono">
                    v
                </div>
                <div class="max-w-[85%] p-3 rounded-2xl rounded-tl-sm bg-white border border-silverBorder text-ink text-xs leading-relaxed shadow-2xs">
                    ${formatMarkdown(content)}
                </div>
            `;
        }

        chatMessages.appendChild(wrapper);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    };

    const sendPrompt = async (promptText: string) => {
        const trimmed = promptText.trim();
        if (!trimmed || !chatMessages) return;

        if (chatStarters) {
            chatStarters.classList.add('hidden');
        }

        history.push({ role: 'user', content: trimmed });
        appendBubble('user', trimmed);

        if (chatInput) chatInput.value = '';
        if (chatSend) chatSend.disabled = true;

        // Lade-Indikator
        const typingEl = document.createElement('div');
        typingEl.className = 'flex items-start gap-2.5';
        typingEl.innerHTML = `
            <div class="w-6 h-6 rounded-full bg-ink text-paper flex items-center justify-center shrink-0 mt-0.5 text-[10px] font-mono">
                v
            </div>
            <div class="px-3.5 py-2.5 rounded-2xl rounded-tl-sm bg-white border border-silverBorder text-inkMuted text-xs font-mono">
                vinje AI analysiert …
            </div>
        `;
        chatMessages.appendChild(typingEl);
        chatMessages.scrollTop = chatMessages.scrollHeight;

        try {
            let reply = '';
            const res = await fetch('/api/chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ messages: history }),
            }).catch(() => null);

            if (res && res.ok) {
                const data = await res.json();
                reply = data?.reply || '';
                if (data?.recommendedTopic) {
                    latestTopic = data.recommendedTopic;
                }
            }

            // Client-Fallback für statisches Hosting (z. B. GitHub Pages ohne Node-Backend)
            if (!reply) {
                const lower = trimmed.toLowerCase();
                if (lower.includes('mail') || lower.includes('backmail') || lower.includes('anruf') || lower.includes('backcall') || lower.includes('voice') || lower.includes('telefon')) {
                    latestTopic = 'KI-Automatisierung';
                    reply = 'Für die Automatisierung zeitraubender Kundenkommunikation im **Mittelstand und E-Commerce** setzen wir auf zwei spezialisierte Kernsysteme:\n• **backmail (KI-E-Mail-Client)**: Verarbeitet, strukturiert und beantwortet eingehende Kunden-E-Mails automatisch mit direktem Abgleich eurer Shop-, ERP- oder CRM-Daten.\n• **backcall (KI-Voice-Assistant)**: Nimmt Telefonanrufe selbstständig entgegen, beantwortet wiederkehrende Fragen, qualifiziert Anliegen vor und leitet strukturierte Infos weiter.';
                } else if (lower.includes('kosten') || lower.includes('preis') || lower.includes('festpreis') || lower.includes('stundensatz')) {
                    latestTopic = 'Potenzial-Beratung';
                    reply = 'Wir arbeiten bewusst **ohne Stundensatz**: Bei uns gibt es einen vorab transparent vereinbarten **Projekt-Festpreis** für die Umsetzung sowie eine **monatliche Pauschale** für laufenden Betrieb, Wartung und Weiterentwicklung (auf Verhandlungsbasis je nach Umfang). Im 20-minütigen Erstgespräch stecken wir euren Rahmen unverbindlich ab.';
                } else if (lower.includes('dsgvo') || lower.includes('datenschutz') || lower.includes('mistral') || lower.includes('europa') || lower.includes('host')) {
                    latestTopic = 'KI-Automatisierung';
                    reply = 'Datenschutz ist bei uns kompromisslos **100 % DSGVO-konform**: Wir setzen ausschließlich auf **europäische Hoster** und verwenden **europäische bzw. lokale Sprachmodelle wie Mistral AI**. Sensible Kunden-E-Mails und Telefonate verlassen niemals den europäischen Rechtsraum.';
                } else if (lower.includes('agentur') || lower.includes('unterschied') || lower.includes('vincent') || lower.includes('jesse')) {
                    latestTopic = 'Potenzial-Beratung';
                    reply = 'Hinter **vinje** stehen **Vincent Grüneklee und Jesse Bakenhus**. Wir sind keine oberflächliche KI-Hype-Agentur, sondern zwei eingespielte Data-Science- & KI-Generalisten: Wir kennen uns aus dem gemeinsamen Studium und haben bereits beim gleichen Arbeitgeber mehrere Projekte zusammen in der Praxis umgesetzt.';
                } else {
                    reply = 'Genau solche Anforderungen schauen wir uns bei **vinje** gerne direkt an – egal ob es um **backmail**, **backcall**, **Multi-Agent-Systeme**, **Forecasting-Modelle** oder **Dashboards** geht (100 % DSGVO-konform mit Mistral & EU-Hosting). Übernehmt euer Thema gerne per Klick ins Formular oder bucht direkt einen 20-Min-Termin!';
                }
            }

            typingEl.remove();
            history.push({ role: 'assistant', content: reply });
            appendBubble('assistant', reply);

            if (chatHandoff) {
                chatHandoff.classList.remove('hidden');
            }
        } catch {
            typingEl.remove();
            appendBubble(
                'assistant',
                'Nutzt gerne direkt den Projektkonfigurator unten oder bucht ein 20-Min-Erstgespräch via Calendly!'
            );
        } finally {
            if (chatSend) chatSend.disabled = false;
        }
    };

    starterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
            const prompt = btn.getAttribute('data-prompt');
            if (prompt) sendPrompt(prompt);
        });
    });

    chatForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (chatInput?.value) {
            sendPrompt(chatInput.value);
        }
    });

    // Nahtloser Übergang zum Kontaktformular inkl. Vorausfüllen
    transferBtn?.addEventListener('click', () => {
        const contactSection = document.getElementById('kontakt');
        const messageTextarea = document.getElementById('message') as HTMLTextAreaElement | null;
        const topicButtons = document.querySelectorAll('.topic-btn');

        // Passenden Themen-Tab im Konfigurator aktivieren
        topicButtons.forEach((btn) => {
            if (btn.getAttribute('data-topic') === latestTopic) {
                (btn as HTMLButtonElement).click();
            }
        });

        // Gesprächszusammenfassung in das Nachrichtenfeld übernehmen
        const userInputs = history
            .filter((m) => m.role === 'user')
            .map((m) => `• ${m.content}`)
            .join('\n');

        if (messageTextarea && userInputs) {
            messageTextarea.value = `Aus dem vinje AI-Chat übernommenes Thema (${latestTopic}):\n${userInputs}\n\nWeitere Details: `;
        }

        toggleChat(false);
        contactSection?.scrollIntoView({ behavior: 'smooth' });
        setTimeout(() => messageTextarea?.focus(), 600);
    });
</script>
