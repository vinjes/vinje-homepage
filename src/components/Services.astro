---
import { segStyle } from '../scroll/timeline';
import ServiceChain from './ServiceChain.astro';

// Ketten aus der früheren Pipeline-Karte im Hero (Tabs Machine Learning, Daten & BI): Input → Engine → Ergebnis
const CHAINS = {
    ml: [
        { step: 'Kanal & Daten-Input', title: 'Bestellhistorie, Lager- & Prozessdaten', desc: 'Historische Zeitreihen & strukturierte Unternehmensdaten' },
        { step: 'vinje Engine', title: 'Python-Pipelines & Forecasting-Modelle', desc: 'Individuell trainierte Machine-Learning-Algorithmen' },
        { step: 'Produktives System', results: [['Forecasting', 'Absatz-, Nachfrage- & Bestandsprognosen'], ['Python & Docker', 'Sauber deployte, wartbare ML-Pipelines']] },
    ],
    bi: [
        { step: 'Kanal & Daten-Input', title: 'Verteilte Shop-, ERP- & SQL-Datenquellen', desc: 'Unübersichtliche Tabellen & getrennte Datentöpfe' },
        { step: 'vinje Engine', title: 'SQL-Modellierung, Supabase & Python-ETL', desc: 'Automatisierte Aufbereitung & Strukturierung' },
        { step: 'Produktives System', results: [['Live-Dashboards', 'Alle Kennzahlen an einem Ort'], ['Custom Web-Tools', 'Maßgeschneiderte interne Anwendungen']] },
    ],
};
---
<!-- ==================== 3. LEISTUNGEN ==================== -->
<!-- Läuft über der Bühne (Journey.astro, Slot "lower"): je Bereich eine Station (data-seg), die Kamera wechselt zwischen drei Cluster-Gruppen -->
<section id="leistungen">
    <!-- Station services-ki: Kopf + 01 KI-Automatisierung -->
    <div data-seg="services-ki" class="journey-block" style={segStyle('services-ki')}>
        <div class="max-w-6xl w-full mx-auto px-5 sm:px-8 py-16">
            <div class="max-w-xl space-y-10">
                <div class="reveal">
                    <span class="text-xs font-mono uppercase tracking-widest text-inkMuted">Leistungen</span>
                    <h2 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight text-ink mt-2">
                        Echte Data-Science- &amp; KI-Expertise statt Standard-Baukasten.
                    </h2>
                </div>
                <!-- Karte 01: KI-Automatisierung & Kundensysteme -->
                <article class="silver-card rounded-2xl border border-silverBorder p-7 sm:p-8 flex flex-col justify-between reveal">
                    <div>
                        <div class="flex items-center justify-between mb-8">
                            <span class="font-mono text-xs font-medium px-2.5 py-1 rounded-md bg-ink text-paper">01 // Hauptfokus</span>
                            <svg class="w-6 h-6 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                            </svg>
                        </div>
                        <h3 class="font-display text-xl font-semibold text-ink tracking-tight">
                            KI-Automatisierung
                        </h3>
                        <p class="text-sm text-inkMuted mt-3 leading-relaxed">
                            Schluss mit lästigen Routine-E-Mails und Dauer-Anrufen: Mit <strong>backmail</strong> und <strong>backcall</strong> automatisieren und verbessern wir eure gesamte Kundenkommunikation.
                        </p>
                    </div>
                    <ul class="mt-8 pt-5 border-t border-silverBorder space-y-2 text-xs text-inkMuted">
                        <li class="flex items-center gap-1"><span class="w-1 h-1 rounded-full bg-ink shrink-0"></span><strong>backmail:</strong>Intelligenter E-Mail-Assistant</li>
                        <li class="flex items-center gap-1"><span class="w-1 h-1 rounded-full bg-ink shrink-0"></span><strong>backcall:</strong>KI-Voice-Assistant für Telefonanrufe</li>
                        <li class="flex items-center gap-1"><span class="w-1 h-1 rounded-full bg-ink shrink-0"></span>Multi-Agent-Systeme, RAG-Chatbots &amp; KI-Integration</li>
                    </ul>
                </article>
            </div>
        </div>
    </div>

    <!-- Stationen services-ml und services-bi: Karte + Kette aus der früheren Pipeline-Karte -->
    <div data-seg="services-ml" class="journey-block" style={segStyle('services-ml')}>
        <div class="max-w-6xl w-full mx-auto px-5 sm:px-8 py-16">
            <div class="max-w-xl space-y-6">
                <!-- Karte 02: Machine Learning -->
                <article class="silver-card rounded-2xl border border-silverBorder p-7 sm:p-8 flex flex-col justify-between reveal">
                    <div>
                        <div class="flex items-center justify-between mb-8">
                            <span class="font-mono text-xs font-medium px-2.5 py-1 rounded-md bg-paper border border-silverBorder text-ink">02</span>
                            <svg class="w-6 h-6 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5"/>
                            </svg>
                        </div>
                        <h3 class="font-display text-xl font-semibold text-ink tracking-tight">
                            Machine Learning
                        </h3>
                        <p class="text-sm text-inkMuted mt-3 leading-relaxed">
                            Fundierte Data-Science-Modelle statt Bauchgefühl – wir entwickeln maßgeschneiderte Algorithmen und stabile Python-Pipelines für euer Tagesgeschäft.
                        </p>
                    </div>
                    <ul class="mt-8 pt-5 border-t border-silverBorder space-y-2 text-xs text-inkMuted">
                        <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-ink shrink-0"></span>Forecasting-Modelle (Absatz, Bestand &amp; Nachfrage)</li>
                        <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-ink shrink-0"></span>Maßgeschneiderte Python-Pipelines &amp; Datenmodelle</li>
                        <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-ink shrink-0"></span>Klassifikation, Scoring &amp; Mustererkennung</li>
                    </ul>
                </article>
                <ServiceChain chain={CHAINS.ml} />
            </div>
        </div>
    </div>

    <div data-seg="services-bi" class="journey-block" style={segStyle('services-bi')}>
        <div class="max-w-6xl w-full mx-auto px-5 sm:px-8 py-16">
            <div class="max-w-xl space-y-6">
                <!-- Karte 03: Datenanalyse, BI & Web-Tools -->
                <article class="silver-card rounded-2xl border border-silverBorder p-7 sm:p-8 flex flex-col justify-between reveal">
                    <div>
                        <div class="flex items-center justify-between mb-8">
                            <span class="font-mono text-xs font-medium px-2.5 py-1 rounded-md bg-paper border border-silverBorder text-ink">03</span>
                            <svg class="w-6 h-6 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>
                            </svg>
                        </div>
                        <h3 class="font-display text-xl font-semibold text-ink tracking-tight">
                            Datenanalyse &amp; BI
                        </h3>
                        <p class="text-sm text-inkMuted mt-3 leading-relaxed">
                            Klare Entscheidungsgrundlagen und individuelle Werkzeuge: Wir führen verteilte Daten zusammen und bauen genau die Oberflächen, die euer Team braucht.
                        </p>
                    </div>
                    <ul class="mt-8 pt-5 border-t border-silverBorder space-y-2 text-xs text-inkMuted">
                        <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-ink shrink-0"></span>Übersichtliche Dashboards &amp; KPI-Auswertungen</li>
                        <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-ink shrink-0"></span>Individuelle interne Web-Tools &amp; Schnittstellen</li>
                        <li class="flex items-center gap-2"><span class="w-1 h-1 rounded-full bg-ink shrink-0"></span>Saubere SQL- &amp; Datenbank-Architekturen</li>
                    </ul>
                </article>
                <ServiceChain chain={CHAINS.bi} />
            </div>
        </div>
    </div>

    <!-- Station stack-eu: Tech-Stack & DSGVO / EU-Souveränität (zusammengelegt) -->
    <div data-seg="stack-eu" class="journey-block" style={segStyle('stack-eu')}>
        <div class="max-w-6xl w-full mx-auto px-5 sm:px-8 py-16">
            <div class="max-w-3xl">
                <!-- Tech-Stack & DSGVO / EU-Souveränität -->
                <div class="space-y-6 reveal">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <span class="text-xs font-mono uppercase tracking-wider text-inkMuted">Unser Kern-Stack //</span>
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="px-3 py-1.5 rounded-lg bg-white/80 border border-silverBorder text-xs font-mono text-ink">Mistral AI &amp; Lokale LLMs</span>
                            <span class="px-3 py-1.5 rounded-lg bg-white/80 border border-silverBorder text-xs font-mono text-ink">Python</span>
                            <span class="px-3 py-1.5 rounded-lg bg-white/80 border border-silverBorder text-xs font-mono text-ink">SQL</span>
                            <span class="px-3 py-1.5 rounded-lg bg-white/80 border border-silverBorder text-xs font-mono text-ink">Supabase</span>
                            <span class="px-3 py-1.5 rounded-lg bg-white/80 border border-silverBorder text-xs font-mono text-ink">Docker</span>
                            <span class="px-3 py-1.5 rounded-lg bg-ink text-paper text-xs font-mono">100 % EU-Hosting</span>
                        </div>
                    </div>

                    <!-- DSGVO & Europäische KI-Souveränität Box -->
                    <div class="p-6 rounded-2xl bg-white/85 border border-silverBorder flex flex-col md:flex-row md:items-center justify-between gap-6">
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 rounded-xl bg-ink text-paper flex items-center justify-center shrink-0 mt-0.5">
                                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
                                </svg>
                            </div>
                            <div>
                                <h3 class="font-display text-base font-semibold text-ink">
                                    100 % DSGVO-konform: Europäische Hoster &amp; Mistral LLMs
                                </h3>
                                <p class="text-xs sm:text-sm text-inkMuted mt-1 leading-relaxed max-w-3xl">
                                    Gerade bei sensiblen Kunden-E-Mails und Telefonaten im Mittelstand machen wir keine Kompromisse: Wir nutzen ausschließlich <strong>europäische Hoster</strong> sowie <strong>europäische und lokale Sprachmodelle wie Mistral</strong>. Eure Unternehmens- und Kundendaten verlassen niemals den europäischen Rechtsraum.
                                </p>
                            </div>
                        </div>
                        <span class="shrink-0 self-start md:self-center text-[11px] font-mono uppercase tracking-wider px-3 py-1.5 rounded-full bg-paper border border-silverBorder text-ink">
                            EU Data Sovereignty
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
