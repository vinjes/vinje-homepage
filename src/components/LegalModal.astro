<!-- ==================== MODAL OVERLAY FÜR IMPRESSUM & DATENSCHUTZ ==================== -->
<div id="legal-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-ink/40 backdrop-blur-xs">
    <div class="bg-paper border border-silverBorder rounded-2xl max-w-lg w-full p-6 sm:p-8 shadow-2xl relative">
        <div class="flex items-center justify-between pb-4 border-b border-silverBorder">
            <h3 id="modal-title" class="font-display text-lg font-semibold text-ink">Impressum</h3>
            <button type="button" id="close-modal-btn" class="p-1.5 rounded-lg text-inkMuted hover:text-ink hover:bg-paperDark transition-colors cursor-pointer" aria-label="Schließen">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>
        <div id="modal-body" class="mt-4 text-sm text-inkMuted space-y-3 leading-relaxed max-h-[60vh] overflow-y-auto pr-1">
            <!-- Dynamischer Inhalt -->
        </div>
    </div>
</div>

<script>
    const legalModal = document.getElementById('legal-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalBody = document.getElementById('modal-body');
    const closeModalBtn = document.getElementById('close-modal-btn');
    const legalTriggers = document.querySelectorAll('.legal-trigger');

    const legalContent: Record<string, { title: string; html: string }> = {
        impressum: {
            title: 'Impressum',
            html: `
                <p><strong>Angaben gemäß § 5 DDG:</strong><br>
                vinje — Vincent Grüneklee &amp; Jesse Bakenhus<br>
                Kölner Straße 28<br>
                40211 Düsseldorf</p>
                <p><strong>Kontakt:</strong><br>
                E-Mail: info@vinje.de<br>
                Web: www.vinje.de</p>
                <p><strong>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV:</strong><br>
                Vincent Grüneklee &amp; Jesse Bakenhus<br>
                Kölner Straße 28, 40211 Düsseldorf</p>
            `
        },
        datenschutz: {
            title: 'Datenschutzerklärung',
            html: `
                <p><strong>1. Datenschutz auf einen Blick</strong><br>
                Wir nehmen den Schutz Ihrer persönlichen Daten sehr ernst. Personenbezogene Daten werden auf dieser Website nur im technisch notwendigen Umfang sowie zur Bearbeitung Ihrer Kontaktanfrage erhoben.</p>
                <p><strong>2. Kontaktaufnahme</strong><br>
                Wenn Sie uns per Kontaktformular oder E-Mail (info@vinje.de) Anfragen zukommen lassen, werden Ihre Angaben inklusive der von Ihnen angegebenen Kontaktdaten zwecks Bearbeitung der Anfrage bei uns gespeichert. Diese Daten geben wir nicht ohne Ihre Einwilligung weiter.</p>
                <p><strong>3. Ihre Rechte</strong><br>
                Sie haben jederzeit das Recht auf unentgeltliche Auskunft über Ihre gespeicherten personenbezogenen Daten sowie ein Recht auf Berichtigung, Sperrung oder Löschung dieser Daten.</p>
            `
        }
    };

    legalTriggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
            const type = trigger.getAttribute('data-modal');
            if (!type) return;
            const content = legalContent[type];
            if (!content || !modalTitle || !modalBody || !legalModal) return;
            modalTitle.textContent = content.title;
            modalBody.innerHTML = content.html;
            legalModal.classList.remove('hidden');
            legalModal.classList.add('flex');
        });
    });

    const closeLegalModal = () => {
        if (!legalModal) return;
        legalModal.classList.add('hidden');
        legalModal.classList.remove('flex');
    };

    if (closeModalBtn) closeModalBtn.addEventListener('click', closeLegalModal);
    if (legalModal) {
        legalModal.addEventListener('click', (e) => {
            if (e.target === legalModal) closeLegalModal();
        });
    }
</script>
