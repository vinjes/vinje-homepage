---
import { forecastChart } from '../demo/chart';
// Mini-Demo zu Stufe 02: Absatzprognose eines Modells mit Genauigkeit und Einflussfaktoren. Alle Zahlen sind Beispieldaten.
const IST = [52, 55, 50, 58, 61, 57, 63, 66, 62, 68, 71, 67];
const H: Record<'4' | '12', { fc: number[]; value: string; range: string }> = {
    '4': { fc: [67, 72, 70, 75, 78], value: '3.420', range: '3.210 – 3.630' },
    '12': { fc: [67, 72, 70, 75, 78, 74, 80, 83, 79, 85, 88, 84, 90], value: '10.950', range: '9.980 – 11.920' },
};
const FACTORS: [string, number][] = [['Saison', 38], ['Aktionen', 27], ['Feiertage', 19], ['Wetter', 16]];
const views = (['4', '12'] as const).map((k) => ({ k, h: H[k], c: forecastChart(IST, H[k].fc, { lo: 40, hi: 110, spread: k === '4' ? 2.5 : 1.6 }) }));
---
<figure data-dash class="reveal rounded-2xl bg-white border border-silverBorder shadow-[0_24px_60px_-24px_rgba(20,20,20,0.25)] p-4 sm:p-6 text-ink">
    <div class="flex items-center justify-between gap-3">
        <div>
            <p class="font-display text-sm font-semibold">Absatzprognose · Produkt A</p>
            <p class="text-[11px] text-inkMuted">Demo mit Beispieldaten</p>
        </div>
        <div class="flex p-0.5 rounded-lg bg-paper border border-silverBorder text-xs" role="group" aria-label="Prognose-Horizont">
            <button type="button" data-set="4" aria-pressed="true" class="dash-tab px-2.5 py-1 rounded-md">4 Wo.</button>
            <button type="button" data-set="12" aria-pressed="false" class="dash-tab px-2.5 py-1 rounded-md">12 Wo.</button>
        </div>
    </div>

    {views.map(({ k, h, c }) => (
        <div data-only={k} hidden={k !== '4'}>
            <div class="mt-4 flex flex-wrap items-end justify-between gap-2">
                <div>
                    <p class="text-[11px] text-inkMuted">Erwarteter Absatz, nächste {k} Wochen</p>
                    <p class="font-display text-2xl font-semibold">{h.value} <span class="text-sm font-normal text-inkMuted">Stk.</span></p>
                </div>
                <p class="text-[11px] text-inkMuted">Wahrscheinlich zwischen {h.range}</p>
            </div>
            <svg viewBox={`0 0 ${c.W} ${c.H}`} class="w-full h-auto mt-3" role="img" aria-label={`Absatz der letzten 12 Wochen und Prognose für ${k} Wochen (Beispieldaten)`}>
                {[0.25, 0.5, 0.75].map((f) => <line x1="0" x2={c.W} y1={c.H * f} y2={c.H * f} stroke="#EFECE4" />)}
                <line x1={c.todayX} x2={c.todayX} y1="4" y2={c.H - 4} stroke="#C8C6BE" stroke-dasharray="2 3" />
                <text x={Number(c.todayX) + 4} y="12" font-size="9" fill="#555555">heute</text>
                <polygon points={c.band} fill="#2563EB" fill-opacity="0.12" />
                <polyline points={c.ist} fill="none" stroke="#141414" stroke-width="2" stroke-linejoin="round" class="dash-draw" />
                <polyline points={c.fc} fill="none" stroke="#2563EB" stroke-width="2" stroke-dasharray="5 4" stroke-linejoin="round" />
                <circle cx={c.last[0]} cy={c.last[1]} r="4" fill="#2563EB" />
            </svg>
        </div>
    ))}

    <div class="mt-4 grid grid-cols-2 gap-2">
        <div class="rounded-xl bg-paper border border-silverBorder p-3">
            <p class="text-[11px] text-inkMuted">Gelernt aus</p>
            <p class="text-sm font-semibold mt-0.5">2 Jahren Verkaufsdaten</p>
        </div>
        <div class="rounded-xl bg-paper border border-silverBorder p-3">
            <p class="text-[11px] text-inkMuted">Durchschnittliche Abweichung</p>
            <p class="text-sm font-semibold mt-0.5">6,2 %</p>
        </div>
    </div>

    <div class="mt-3 rounded-xl border border-silverBorder p-3">
        <p class="text-[11px] text-inkMuted">Was die Prognose beeinflusst</p>
        <div class="mt-2 space-y-1.5">
            {FACTORS.map(([name, pct]) => (
                <div class="grid grid-cols-[4.5rem_1fr_2.5rem] items-center gap-2 text-[11px]">
                    <span>{name}</span>
                    <span class="h-2 rounded-full bg-paper overflow-hidden"><span class="dash-bar block h-full rounded-full bg-blue-600" style={`width: ${pct * 2}%`}></span></span>
                    <span class="text-right text-inkMuted">{pct} %</span>
                </div>
            ))}
        </div>
    </div>
</figure>

<script>
    import '../demo/tabs';
</script>
