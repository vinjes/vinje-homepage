<script>
    const pipelineData: Record<string, {
        inputTitle: string;
        inputDesc: string;
        processTitle: string;
        processDesc: string;
        badge: string;
        metric1: string;
        label1: string;
        metric2: string;
        label2: string;
    }> = {
        ki: {
            inputTitle: 'Kunden-E-Mails, Anrufe & Support-Anfragen',
            inputDesc: 'Wiederkehrende Kommunikation im Mittelstand & E-Commerce',
            processTitle: 'backmail, backcall & Multi-Agenten',
            processDesc: 'Mistral & lokale LLMs auf europäischen Servern',
            badge: 'DSGVO-konform',
            metric1: 'backmail',
            label1: 'KI-E-Mail-Client & Auto-Antworten',
            metric2: 'backcall',
            label2: 'KI-Voice-Assistant für Telefonanrufe'
        },
        ml: {
            inputTitle: 'Bestellhistorie, Lager- & Prozessdaten',
            inputDesc: 'Historische Zeitreihen & strukturierte Unternehmensdaten',
            processTitle: 'Python-Pipelines & Forecasting-Modelle',
            processDesc: 'Individuell trainierte Machine-Learning-Algorithmen',
            badge: 'Data Science',
            metric1: 'Forecasting',
            label1: 'Absatz-, Nachfrage- & Bestandsprognosen',
            metric2: 'Python & Docker',
            label2: 'Sauber deployte, wartbare ML-Pipelines'
        },
        analyse: {
            inputTitle: 'Verteilte Shop-, ERP- & SQL-Datenquellen',
            inputDesc: 'Unübersichtliche Tabellen & getrennte Datentöpfe',
            processTitle: 'SQL-Modellierung, Supabase & Python-ETL',
            processDesc: 'Automatisierte Aufbereitung & Strukturierung',
            badge: 'Analytics & Tools',
            metric1: 'Live-Dashboards',
            label1: 'Alle Kennzahlen an einem Ort',
            metric2: 'Custom Web-Tools',
            label2: 'Maßgeschneiderte interne Anwendungen'
        }
    };

    const tabs = document.querySelectorAll('.pipeline-tab');
    const pipelineContent = document.getElementById('pipeline-content');

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            const key = tab.getAttribute('data-pipeline');
            if (!key) return;
            const data = pipelineData[key];
            if (!data || !pipelineContent) return;

            // Tab-Styles aktualisieren
            tabs.forEach(t => {
                t.classList.remove('bg-ink', 'text-paper');
                t.classList.add('text-inkMuted');
            });
            tab.classList.add('bg-ink', 'text-paper');
            tab.classList.remove('text-inkMuted');

            // Animation neu triggern
            pipelineContent.classList.remove('pipeline-fade');
            void pipelineContent.offsetWidth; // Reflow erzwingen
            pipelineContent.classList.add('pipeline-fade');

            // Inhalte aktualisieren
            const setText = (id: string, val: string) => {
                const el = document.getElementById(id);
                if (el) el.textContent = val;
            };
            setText('pipe-input-title', data.inputTitle);
            setText('pipe-input-desc', data.inputDesc);
            setText('pipe-process-title', data.processTitle);
            setText('pipe-process-desc', data.processDesc);
            setText('pipe-badge', data.badge);
            setText('pipe-metric-1', data.metric1);
            setText('pipe-label-1', data.label1);
            setText('pipe-metric-2', data.metric2);
            setText('pipe-label-2', data.label2);
        });
    });

    // Fließende metallisch-silbrige Seidenwellen im Hero-Canvas
    const canvas = document.getElementById('hero-wave-canvas') as HTMLCanvasElement | null;
    if (canvas) {
        const ctx = canvas.getContext('2d');
        let width = 0;
        let height = 0;
        let time = 0;
        let targetMouseX = 0.5;
        let targetMouseY = 0.5;
        let mouseX = 0.5;
        let mouseY = 0.5;

        const resize = () => {
            const rect = canvas.getBoundingClientRect();
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            width = rect.width;
            height = rect.height;
            canvas.width = width * dpr;
            canvas.height = height * dpr;
            if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };

        resize();
        window.addEventListener('resize', resize);

        window.addEventListener('mousemove', (e) => {
            targetMouseX = e.clientX / Math.max(window.innerWidth, 1);
            targetMouseY = e.clientY / Math.max(window.innerHeight, 1);
        }, { passive: true });

        const drawRibbon = (opts: {
            yBase: number;
            amp1: number;
            amp2: number;
            freq1: number;
            freq2: number;
            speed: number;
            phase: number;
            thickness: number;
            strokeColor: string;
            fillTop: string;
            fillBottom: string;
        }) => {
            if (!ctx) return;
            const steps = 64;
            const parallaxY = (mouseY - 0.5) * 28;
            const parallaxPhase = (mouseX - 0.5) * 0.8;

            ctx.beginPath();
            for (let i = 0; i <= steps; i++) {
                const ratio = i / steps;
                const x = ratio * width;
                const wave =
                    Math.sin(ratio * opts.freq1 + time * opts.speed + opts.phase + parallaxPhase) * opts.amp1 +
                    Math.cos(ratio * opts.freq2 - time * (opts.speed * 0.7) + opts.phase) * opts.amp2;
                const y = height * opts.yBase + wave + ratio * 110 - 55 + parallaxY;
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }

            // Sanfte metallische Füllebene unter der Welle
            ctx.save();
            ctx.lineTo(width, height + 40);
            ctx.lineTo(0, height + 40);
            ctx.closePath();
            const grad = ctx.createLinearGradient(0, height * (opts.yBase - 0.2), width, height * (opts.yBase + 0.35));
            grad.addColorStop(0, opts.fillTop);
            grad.addColorStop(0.55, opts.fillBottom);
            grad.addColorStop(1, 'rgba(247, 246, 242, 0)');
            ctx.fillStyle = grad;
            ctx.fill();
            ctx.restore();

            // Feine silbrige Glanzkante entlang des Wellenkamms
            ctx.beginPath();
            for (let i = 0; i <= steps; i++) {
                const ratio = i / steps;
                const x = ratio * width;
                const wave =
                    Math.sin(ratio * opts.freq1 + time * opts.speed + opts.phase + parallaxPhase) * opts.amp1 +
                    Math.cos(ratio * opts.freq2 - time * (opts.speed * 0.7) + opts.phase) * opts.amp2;
                const y = height * opts.yBase + wave + ratio * 110 - 55 + parallaxY;
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.strokeStyle = opts.strokeColor;
            ctx.lineWidth = opts.thickness;
            ctx.stroke();
        };

        const animate = () => {
            if (!ctx) return;
            time += 0.018;
            mouseX += (targetMouseX - mouseX) * 0.04;
            mouseY += (targetMouseY - mouseY) * 0.04;

            ctx.clearRect(0, 0, width, height);

            // Mehrere überlagerte Seidenwellen im Visitenkarten-Silberstil
            drawRibbon({
                yBase: 0.28,
                amp1: 38,
                amp2: 22,
                freq1: 3.4,
                freq2: 5.2,
                speed: 0.9,
                phase: 0.4,
                thickness: 1.6,
                strokeColor: 'rgba(255, 255, 255, 0.85)',
                fillTop: 'rgba(255, 255, 255, 0.55)',
                fillBottom: 'rgba(205, 203, 194, 0.22)',
            });

            drawRibbon({
                yBase: 0.52,
                amp1: 46,
                amp2: 26,
                freq1: 2.8,
                freq2: 4.5,
                speed: -0.75,
                phase: 1.9,
                thickness: 2.2,
                strokeColor: 'rgba(180, 178, 168, 0.45)',
                fillTop: 'rgba(223, 221, 213, 0.42)',
                fillBottom: 'rgba(174, 172, 163, 0.16)',
            });

            drawRibbon({
                yBase: 0.68,
                amp1: 34,
                amp2: 20,
                freq1: 3.9,
                freq2: 6.0,
                speed: 1.1,
                phase: 3.5,
                thickness: 2.0,
                strokeColor: 'rgba(255, 255, 255, 0.92)',
                fillTop: 'rgba(255, 255, 255, 0.65)',
                fillBottom: 'rgba(195, 193, 184, 0.25)',
            });

            if (!still) requestAnimationFrame(animate);
        };

        // Bei reduzierter Bewegung bleibt es beim ersten, statischen Bild
        const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        requestAnimationFrame(animate);
    }
</script>
